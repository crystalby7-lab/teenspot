rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function validStops(s) { return s is list && s.size() >= 2 && s.size() <= 8; }

    // 관리자 목록: 콘솔에서만 추가
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // 회원 정보: 본인만
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 10
        && request.resource.data.birthYear is int
        && request.resource.data.agreements.terms == true
        && request.resource.data.agreements.privacy == true
        && request.resource.data.agreements.guide == true;

      match /saves/{sid} {
        allow read, write: if isMe(uid);
      }
    }

    // 공개 프로필: 다른 사람에게 보이는 정보만 (닉네임, 아바타, 나이, 태그)
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'birthYear', 'birthMonth', 'avatar', 'badge', 'styleTags', 'playTags', 'personalColor', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 10
        && (!('styleTags' in request.resource.data) || request.resource.data.styleTags.size() <= 3)
        && (!('playTags' in request.resource.data) || request.resource.data.playTags.size() <= 3);
      allow delete: if isMe(uid);
      allow write: if isAdmin();
    }

    // 닉네임 중복 방지
    match /nicknames/{nick} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && nick.size() >= 2 && nick.size() <= 10;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 코스: 관리자만 등록·수정
    match /courses/{cid} {
      allow read: if signedIn();
      allow write: if isAdmin();

      // 후기: 1인 1개, 본인만 작성·수정·삭제 (관리자는 삭제 가능)
      match /reviews/{uid} {
        allow create, update: if hasProfile() && isMe(uid)
          && request.resource.data.uid == uid
          && request.resource.data.recommend is bool
          && request.resource.data.spent is int
          && request.resource.data.spent >= 0
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 100;
        allow delete: if isMe(uid) || isAdmin();
      }
    }
    match /{path=**}/reviews/{uid} {
      allow read: if signedIn();
    }

    // 투표: 관리자가 등록(유저 투표는 승인 시 관리자가 생성), 1인 1표, 변경 불가
    match /polls/{pid} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      match /votes/{uid} {
        allow read: if signedIn();
        allow create: if hasProfile() && isMe(uid)
          && request.resource.data.choice in ['a', 'b', 'c', 'd']
          && (get(/databases/$(database)/documents/polls/$(pid)).data.get('endsAt', null) == null
              || request.time.toMillis() < get(/databases/$(database)/documents/polls/$(pid)).data.endsAt);
        allow delete: if isMe(uid) || isAdmin()
          || get(/databases/$(database)/documents/polls/$(pid)).data.uid == request.auth.uid;
      }
    }

    // 사진: 압축된 이미지 데이터 (1MB 미만)
    match /images/{iid} {
      allow read: if signedIn();
      allow create: if hasProfile()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.data.matches('^data:image/jpeg;base64,.*');
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 피드 게시물: 작성 시 검토 중, 관리자 승인 후 공개
    match /posts/{pid} {
      function sameImg(k) {
        return !(k in resource.data) || request.resource.data[k].img == resource.data[k].img;
      }
      allow read: if signedIn() && (resource.data.status == 'approved'
        || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if hasProfile()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['vote', 'review']
        && request.resource.data.text.size() <= 100;
      // 작성자 글 수정: 공개 후에는 설명만, 공개 전에는 질문·선택지 이름도 (사진은 그대로)
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 100
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          || (resource.data.status != 'approved'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'question', 'a', 'b', 'c', 'd', 'status', 'rejectReason'])
            && sameImg('a') && sameImg('b') && sameImg('c') && sameImg('d'))));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // 좋아요·칭찬: 1인 1개, 본인 것만
      match /reactions/{uid} {
        allow create, update: if hasProfile() && isMe(uid)
          && request.resource.data.uid == uid
          && request.resource.data.like is bool;
        allow delete: if isMe(uid) || isAdmin()
          || get(/databases/$(database)/documents/posts/$(pid)).data.uid == request.auth.uid;
      }
    }
    match /{path=**}/reactions/{uid} {
      allow read: if signedIn();
    }

    // 코스 제보: 본인 작성, 관리자 승인
    match /submissions/{sid} {
      allow create: if hasProfile()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validStops(request.resource.data.stops);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 신고: 누구나 작성, 관리자만 처리
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
